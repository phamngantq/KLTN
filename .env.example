# Sample source data. Run `npm run seed:sample:local` for local D1, or explicitly
# `npm run seed:sample:staging:v2` for the staging_v2 D1. Never seed production.

# The local seed command replaces GENERATE with a random password in ignored .wrangler/.
# Read that file to sign in. Do not reuse this account or password outside local D1.
SAMPLE_ADMIN_EMAIL="local-admin@example.test"
SAMPLE_ADMIN_DISPLAY_NAME="Kiểm duyệt viên mẫu"
SAMPLE_ADMIN_PASSWORD="GENERATE"
SAMPLE_STAGING_ADMIN_EMAIL="staging-admin@example.test"
SAMPLE_STAGING_PARENT_EMAIL="sample-parent@example.test"

# Three Figma fee formulas. Local seed creates drafts. Authorized staging V2
# seed publishes version 1 of each formula for display and tutor selection.
# 10000 basis points = 100%; 30000 = three lessons.
SAMPLE_FEE_FIRST_TITLE="50% buổi học đầu tiên"
SAMPLE_FEE_FIRST_POLICY="Phí nhận lớp bằng 50% học phí buổi học đầu tiên."
SAMPLE_FEE_FIRST_RATE_BPS="5000"
SAMPLE_FEE_LESSONS_TITLE="3 buổi học, đặt cọc 50%"
SAMPLE_FEE_LESSONS_POLICY="Phí nhận lớp bằng học phí 3 buổi; đặt cọc trước 50% phí nhận lớp."
SAMPLE_FEE_LESSONS_RATE_BPS="30000"
SAMPLE_FEE_LESSONS_DEPOSIT_BPS="5000"
SAMPLE_FEE_MONTHLY_TITLE="40% học phí tháng"
SAMPLE_FEE_MONTHLY_POLICY="Phí nhận lớp bằng 40% học phí tháng."
SAMPLE_FEE_MONTHLY_RATE_BPS="4000"

# Reference-only tables from figma/src/app/pages/admin/AdminPricingFeesPage.tsx.
# The current D1 schema has no tuition-per-session or flat class-fee table.
# These variables preserve the sample data but are not published or used as billing authority.
SAMPLE_TUITION_PRICES_JSON='[{"subject":"Toán","grade":"Lớp 6-7","level":"basic","pricePerSessionMinor":150000,"mode":"online"},{"subject":"Toán","grade":"Lớp 6-7","level":"basic","pricePerSessionMinor":180000,"mode":"offline"},{"subject":"Toán","grade":"Lớp 8-9","level":"basic","pricePerSessionMinor":180000,"mode":"online"},{"subject":"Toán","grade":"Lớp 10-12","level":"advanced","pricePerSessionMinor":250000,"mode":"online"},{"subject":"Tiếng Anh","grade":"Lớp 6-9","level":"basic","pricePerSessionMinor":200000,"mode":"online"},{"subject":"Tiếng Anh","grade":"IELTS/TOEIC","level":"intensive","pricePerSessionMinor":350000,"mode":"online"}]'
SAMPLE_CLASS_FEES_JSON='[{"mode":"online","minFeeMinor":300000,"maxFeeMinor":500000,"description":"Phí nhận lớp online, thanh toán một lần khi bắt đầu dạy"},{"mode":"offline","minFeeMinor":0,"maxFeeMinor":200000,"description":"Phí nhận lớp offline tùy thuộc vào khoảng cách và yêu cầu"}]'

# Source: figma/src/app/pages/public/ClassListPage.tsx. All eight rows remain here for traceability.
# Only six map faithfully to the current single-subject, school-grade domain for staging.
# `seedOnStaging` is seed-script input, not a Worker runtime setting.
