0,"windows":[{"weekday":7,"startLocal":"14:00","endLocal":"16:00"}],"description":"Lớp học nhóm 3-4 học sinh lớp 11, cùng trường. Cần gia sư có phương pháp dạy hấp dẫn.","seedOnStaging":true},{"sourceId":"figma-public-class-06","subjectId":"subj_math","grade":"Lớp 12","mode":"online","publicArea":"Trực tuyến (lớp mẫu)","expectedBudgetMinor":250000,"windows":[{"weekday":1,"startLocal":"20:00","endLocal":"21:30"},{"weekday":3,"startLocal":"20:00","endLocal":"21:30"},{"weekday":5,"startLocal":"20:00","endLocal":"21:30"}],"description":"Học sinh lớp 12 cần ôn thi Toán khối A, A1. Học online qua Zoom hoặc Google Meet.","seedOnStaging":true},{"sourceId":"figma-public-class-07","subjectId":"subj_literature","grade":"Lớp 9","mode":"offline","publicArea":"Ba Đình, Hà Nội (lớp mẫu)","expectedBudgetMinor":180000,"windows":[{"weekday":2,"startLocal":"18:00","endLocal":"19:30"},{"weekday":4,"startLocal":"18:00","endLocal":"19:30"}],"description":"Học sinh lớp 9 cần nâng cao kỹ năng viết văn và làm bài thi.","seedOnStaging":true},{"sourceId":"figma-public-class-08","subjectId":"subj_biology","grade":"Lớp 11","mode":"offline","publicArea":"Hai Bà Trưng, Hà Nội (lớp mẫu)","expectedBudgetMinor":200000,"windows":[{"weekday":3,"startLocal":"19:00","endLocal":"20:30"},{"weekday":5,"startLocal":"19:00","endLocal":"20:30"}],"description":"Học sinh lớp 11 cần học thêm môn Sinh để chuẩn bị thi đại học.","seedOnStaging":true}]'
