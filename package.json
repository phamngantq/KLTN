{
  "name": "tutor-matching-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "wrangler types src/server/worker-configuration.d.ts --env-interface CloudflareBindings --strict-vars=false --check && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "cf-typegen": "wrangler types src/server/worker-configuration.d.ts --env-interface CloudflareBindings --strict-vars=false",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "seed:sample:local": "node scripts/seed-sample-local.mjs",
    "seed:sample:staging:v2": "node scripts/seed-sample-staging-v2.mjs",
    "seed:learner-demo:local": "node scripts/seed-learner-demo.mjs --local",
    "seed:learner-demo:staging:v2": "node scripts/seed-learner-demo.mjs --staging-v2",
    "secret-scan": "node scripts/secret-scan.mjs",
    "e2e": "playwright test",
    "build:staging": "node scripts/build-env.mjs staging",
    "build:staging:v2": "node scripts/build-env.mjs staging_v2",
    "build:preview": "node scripts/build-env.mjs preview",
    "build:production": "node scripts/build-env.mjs production",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:staging:v2": "wrangler d1 migrations apply DB --env staging_v2 --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy:staging:v2": "npm run build:staging:v2 && wrangler deploy",
    "deploy:production": "npm run build:production && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "smoke:preview:browser": "node scripts/smoke-preview-browser.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "0.487.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
